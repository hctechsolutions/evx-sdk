{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@interfaces/*": [
        "src/interfaces/*"
      ],
      "@abis/*": [
        "src/abis/*"
      ],
      "@utils": [
        "src/utils/index.ts"
      ],
      "@providers": [
        "src/providers/index.ts"
      ],
      "@contracts": [
        "src/contracts/index.ts"
      ],
      "@resources": [
        "src/resources/index.ts"
      ],
      "@commands": [
        "src/commands/index.ts"
      ],
      "@commands/*": [
        "src/commands/*"
      ],
      "@queries": [
        "src/queries/index.ts"
      ],
      "@queries/*": [
        "src/queries/*"
      ],
      "@events": [
        "src/events/index.ts"
      ],
      "@events/*": [
        "src/events/*"
      ],
      "@listeners": [
        "src/listeners/index.ts"
      ],
      "@listeners/*": [
        "src/listeners/*"
      ],
      "@tools": [
        "tools/index.ts"
      ],
      "@tools/*": [
        "tools/*"
      ],
      "@enums": [
        "src/enums/index.ts"
      ],
      "@enums/*": [
        "src/enums/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}